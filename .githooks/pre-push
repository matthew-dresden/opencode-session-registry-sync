#!/bin/zsh
# pre-push hook: gitleaks full scan, then reject pushes containing secrets
# or em-dashes.
# Stage 2 logic lives in scan_diff.py (shared with the auto-sync script).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Stage 1: gitleaks full scan of the repository.
# Remediation: real credentials come from AWS SSM Parameter Store /
# Secrets Manager at runtime; test crypto material is generated at
# runtime and never stored in the tree.
GITLEAKS="$(command -v gitleaks || true)"
if [ -z "$GITLEAKS" ]; then
  if [ -x "$HOME/.local/bin/gitleaks" ]; then
    GITLEAKS="$HOME/.local/bin/gitleaks"
  else
    echo "ERROR: gitleaks not found on PATH or at \$HOME/.local/bin/gitleaks." >&2
    echo "Install gitleaks 8.30.1 from https://github.com/gitleaks/gitleaks/releases," >&2
    echo "then re-run the push." >&2
    exit 1
  fi
fi
if ! "$GITLEAKS" detect --config .gitleaks.toml --redact; then
  echo "ERROR: gitleaks findings in repository history; push rejected." >&2
  echo "Remediation: fetch real secrets at runtime from AWS SSM Parameter Store or" >&2
  echo "Secrets Manager; generate test material at runtime; purge the finding" >&2
  echo "from history before pushing." >&2
  exit 1
fi

# Stage 2: hygiene scan of outgoing commits (existing behavior).
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
FAILED=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    base="$EMPTY_TREE"
  else
    base="$remote_sha"
  fi
  if ! python3 .githooks/scan_diff.py --range "${base}..${local_sha}"; then
    FAILED=1
  fi
done

exit "$FAILED"
